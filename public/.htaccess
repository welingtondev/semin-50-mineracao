<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ── Cache Control for static assets ──
<IfModule mod_expires.c>
  ExpiresActive On

  # Fonts — long cache (1 year)
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"

  # Images — long cache (1 year, hashed by Vite)
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS/JS — long cache (hashed filenames from Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML — short cache (must revalidate)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

# ── Security & Performance Headers ──
<IfModule mod_headers.c>
  # Hashed assets (CSS/JS/images) — immutable cache
  <FilesMatch "\.(js|css|woff|woff2|png|webp|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — no cache
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
